{
  "trailingSlash": false,
  "headers": [
    {
      "source": "/media/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)\\.css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    { "source": "/lab/teleop", "destination": "/lab/teleop/index.html" },
    { "source": "/lab/anatomy", "destination": "/lab/anatomy/index.html" },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
